{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReboSlides",
  "version": "0.1.0",
  "identifier": "com.reboslides.desktop",
  "build": {
    "beforeDevCommand": "npm run web",
    "devUrl": "http://localhost:5196",
    "beforeBuildCommand": "npx vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: blob: https://fonts.gstatic.com; connect-src 'self' ipc: http://ipc.localhost data: blob: https://cdn.jsdelivr.net https://fonts.gstatic.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "A slide studio for .reboslides decks",
    "copyright": "MIT",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["reboslides"],
        "name": "ReboSlides deck",
        "description": "ReboSlides deck",
        "mimeType": "application/json",
        "role": "Editor",
        "rank": "Owner"
      }
    ]
  }
}
