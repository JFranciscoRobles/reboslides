# Copy to .env and fill in, to keep the decks in a bucket. Without it they go
# to ./files, and the demo works the same.

# Cloudflare R2: the S3 API address of your account, and "auto" for the region.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=reboslides-demo
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# AWS S3: leave S3_ENDPOINT out, and give the region of the bucket.
# MinIO and others that take the bucket in the path:
# S3_FORCE_PATH_STYLE=true
